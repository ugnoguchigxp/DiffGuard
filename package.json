{
  "name": "diffguard",
  "version": "0.1.0",
  "description": "Diff-aware deterministic review engine for Astmend patches with CLI and MCP service.",
  "private": false,
  "license": "MIT",
  "author": "Y. Noguchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugnoguchi/diffGuard.git"
  },
  "bugs": {
    "url": "https://github.com/ugnoguchi/diffGuard/issues"
  },
  "homepage": "https://github.com/ugnoguchi/diffGuard#readme",
  "keywords": [
    "diff",
    "review",
    "security",
    "mcp",
    "cli",
    "astmend"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp/service": {
      "types": "./dist/mcp/service.d.ts",
      "default": "./dist/mcp/service.js"
    }
  },
  "packageManager": "pnpm@10.24.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "diffguard": "dist/cli.js",
    "diffguard-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs dist",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.3",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ts-morph": "^27.0.2",
    "zod": "^4.3.6"
  }
}
